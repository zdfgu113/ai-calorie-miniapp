PORT=3000
NODE_ENV=development

# Set AI_MOCK=true to run the MVP without a real model key.
AI_MOCK=false

# OpenAI-compatible multimodal chat completions endpoint.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_with_your_backend_api_key
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_THINKING=

# Prefer json_schema for stable structured output.
# Use json_object only when your provider supports JSON mode.
# Use none when your provider rejects response_format.
AI_RESPONSE_FORMAT=json_schema

DAILY_CALORIE_GOAL=1800
MAX_UPLOAD_SIZE_MB=8

# Optional. Use this on cloud platforms with persistent disk, for example:
# SQLITE_DB_PATH=/var/data/app.sqlite
SQLITE_DB_PATH=
