.tabbar {
  position: fixed;
  box-sizing: border-box;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  height: calc(104rpx + constant(safe-area-inset-bottom));
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding: 8rpx 28rpx calc(8rpx + constant(safe-area-inset-bottom));
  padding: 8rpx 28rpx calc(8rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e9e2d6;
  background: #fffdf7;
  box-shadow: 0 -10rpx 28rpx rgba(47, 61, 43, 0.08);
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #6b7280;
}

.tab-item.active {
  color: #128a45;
}

.tab-icon {
  display: block;
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
}
