.history-header {
  margin-bottom: 22rpx;
}

.header-kicker {
  color: #b26b24;
  font-size: 22rpx;
  font-weight: 800;
}

.header-title {
  margin-top: 6rpx;
  color: #17211d;
  font-size: 42rpx;
  font-weight: 800;
}

.trend-card,
.summary-card {
  padding: 28rpx;
  border: 1rpx solid #e4ddcc;
  border-radius: 32rpx;
  background: #fffdf7;
}

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 300rpx;
}

.chart-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.bar-box {
  position: relative;
  height: 188rpx;
  margin: 0 9rpx;
  border-radius: 999rpx;
  background: #ece7dc;
}

.bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 0;
  border-radius: 999rpx;
  background: #128a45;
}

.bar-value {
  margin-top: 12rpx;
  color: #17211d;
  font-size: 21rpx;
  font-weight: 800;
}

.bar-label {
  margin-top: 4rpx;
  color: #687267;
  font-size: 21rpx;
}

.range-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.range-tab {
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  padding: 0;
  color: #687267;
  font-size: 26rpx;
  border-radius: 22rpx;
  background: #efe7d8;
}

.range-tab.active {
  color: #fffdf7;
  background: #17211d;
}

.summary-card {
  margin-top: 24rpx;
  background: #17211d;
}

.summary-label {
  color: #f8f0dd;
  font-size: 24rpx;
}

.summary-number {
  color: #f8d276;
  font-size: 58rpx;
  font-weight: 800;
}

.summary-unit {
  margin-left: 8rpx;
  color: #f8f0dd;
  font-size: 24rpx;
}

.summary-sub {
  margin-top: 4rpx;
  color: #f8f0dd;
  font-size: 22rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.summary-grid > view {
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 247, 0.1);
}

.grid-number {
  color: #fffdf7;
  font-size: 30rpx;
  font-weight: 800;
}

.grid-number.over {
  color: #f7b29c;
}

.grid-label {
  margin-top: 4rpx;
  color: #f8f0dd;
  font-size: 22rpx;
}

.empty {
  margin-top: 24rpx;
  padding: 40rpx;
  color: #687267;
  text-align: center;
  border-radius: 28rpx;
  background: #fffdf7;
}

.history-list {
  margin-top: 24rpx;
}

.history-record {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e9e1d2;
  border-radius: 28rpx;
  background: #fffdf7;
}

.record-name {
  color: #17211d;
  font-size: 30rpx;
  font-weight: 800;
}

.record-meta {
  margin-top: 8rpx;
  color: #687267;
  font-size: 24rpx;
}

.record-calories {
  flex: 0 0 auto;
  color: #128a45;
  font-size: 28rpx;
  font-weight: 800;
}
